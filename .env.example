# Copy to .env.local and fill in. Only public values belong here: they are built
# into the app. Without the Supabase values the app runs in local mode (one
# device, no sync), which is also how the GitHub Pages preview runs.

# Supabase project (EU region), Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Plus subscription).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# EAS project id, needed for push tokens once the project is linked (`npx eas-cli init`).
EAS_PROJECT_ID=

# Secret keys never go here. They are Supabase function secrets, see docs/backend.md:
# CRON_SECRET, REVENUECAT_WEBHOOK_SECRET, EXPO_ACCESS_TOKEN.
